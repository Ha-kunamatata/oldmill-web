---
interface Props {
	src: string;
	alt: string;
	aspectRatio?: '4/5' | '16/9' | '1/1' | '4/3' | '21/9' | '3/2';
	rounded?: 'lg' | 'xl' | '2xl' | 'none';
	label?: string;
	hover?: boolean;
	eager?: boolean;
}

const {
	src,
	alt,
	aspectRatio = '4/3',
	rounded = 'lg',
	hover = false,
	eager = false,
}: Props = Astro.props;

const aspectClasses: Record<NonNullable<Props['aspectRatio']>, string> = {
	'4/5': 'aspect-[4/5]',
	'16/9': 'aspect-video',
	'1/1': 'aspect-square',
	'4/3': 'aspect-[4/3]',
	'21/9': 'aspect-[21/9]',
	'3/2': 'aspect-[3/2]',
};

const roundedClasses = {
	'lg': 'rounded-lg',
	'xl': 'rounded-xl',
	'2xl': 'rounded-2xl',
	'none': '',
};
---

<div class={`${aspectClasses[aspectRatio]} ${roundedClasses[rounded]} bg-gradient-to-br from-border-warm/60 to-bg-soft overflow-hidden relative group`}>
	<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
		<div class="text-center px-4">
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" class="mx-auto text-muted/30 mb-2">
				<rect x="3" y="3" width="18" height="18" rx="2" />
				<circle cx="8.5" cy="8.5" r="1.5" />
				<path d="m21 15-5-5L5 21" />
			</svg>
			<p class="text-[10px] text-muted/40 tracking-[0.2em] uppercase">Coming Soon</p>
		</div>
	</div>

	<img
		src={src}
		alt={alt}
		loading={eager ? 'eager' : 'lazy'}
		decoding="async"
		{...(eager ? { fetchpriority: 'high' } : {})}
		class={`absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-700 ${hover ? 'group-hover:scale-105' : ''}`}
		onload="this.style.opacity='1'"
		onerror="this.remove()"
	/>
</div>
